# Sandbox only. Copy into existing private VPS .env; never commit real credentials.
TALLY_ENV=sandbox
TALLY_DB_PATH=./data/tally.db
TALLY_PUBLIC_BASE_URL=https://tally.mbrelabs.world
TALLY_SHOP_MCP_TOKEN=CHANGE_TO_RANDOM_LONG_SHOP_SECRET
TALLY_SHOP_BOUND_SLUG=
TALLY_SHOP_AGENT_URL=
TALLY_DESK_MCP_TOKEN=CHANGE_TO_DIFFERENT_RANDOM_LONG_DESK_SECRET
TALLY_WEBHOOK_SECRET=CHANGE_TO_THIRD_RANDOM_SECRET
TALLY_PORT=8787

# Platform configuration only. Merchant Paystack keys and webhook secrets are
# submitted through short-lived HTTPS setup links and encrypted per business.
TALLY_PAYSTACK_CONNECTIONS_ENABLED=false
TALLY_CREDENTIAL_ENCRYPTION_KEY=CHANGE_TO_BASE64URL_32_BYTE_KEY
TALLY_CREDENTIAL_ENCRYPTION_KEY_VERSION=v1

# Notion external OAuth: Tally's own integration, not ChatGPT Notion.
TALLY_NOTION_CONNECTIONS_ENABLED=false
TALLY_NOTION_MANAGED_SYNC_ENABLED=false
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=https://tally.mbrelabs.world/integrations/notion/callback
NOTION_API_VERSION=2026-03-11

# Existing Chord environment identifiers, private VPS only.
CHORD_API_KEY=
WORK_SPACE_ID=
TALLY_SHOP_ID=
TALLY_DESK_ID=
