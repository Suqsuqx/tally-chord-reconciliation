# Sandbox only. Copy into existing private VPS .env; never commit real credentials.
TALLY_ENV=sandbox
TALLY_DB_PATH=./data/tally.db
TALLY_PUBLIC_BASE_URL=https://tally.mbrelabs.world
TALLY_SHOP_MCP_TOKEN=CHANGE_TO_RANDOM_LONG_SHOP_SECRET
TALLY_DESK_MCP_TOKEN=CHANGE_TO_DIFFERENT_RANDOM_LONG_DESK_SECRET
TALLY_WEBHOOK_SECRET=CHANGE_TO_THIRD_RANDOM_SECRET
TALLY_PORT=8787

# Existing merchant ASYAN SHOP: Paystack TEST MODE only.
# API key is for server API calls. Prefer rk_test_ restricted key.
PAYSTACK_ENABLE_TEST_WEBHOOK=false
PAYSTACK_TEST_BUSINESS_ID=
PAYSTACK_RESTRICTED_TEST_KEY=
# Modern Paystack-Signature uses whsec_, distinct from API key:
PAYSTACK_WEBHOOK_SIGNING_SECRET=
# Legacy x-paystack-signature requires sk_test_; keep disabled by default:
PAYSTACK_ALLOW_LEGACY_SIGNATURE=false
PAYSTACK_LEGACY_SECRET_KEY=

# Notion external OAuth: Tally's own integration, not ChatGPT Notion.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=https://tally.mbrelabs.world/integrations/notion/callback
NOTION_API_VERSION=2026-03-11
TALLY_ENCRYPTION_KEY=
TALLY_SETUP_SIGNING_KEY=

# Existing Chord environment identifiers, private VPS only.
CHORD_API_KEY=
WORK_SPACE_ID=
TALLY_SHOP_ID=
TALLY_DESK_ID=
